    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "customConditions": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
