# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/

# MLX fine-tune outputs (large binaries — regenerate with llm-kit/train.sh)
llm-kit/adapters/

# Archived gate-passing adapters (large binaries, keep out of git)
llm-kit/adapters-archive/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Secrets. `.env` was NOT ignored, in a repository whose README tells people to
# set ANTHROPIC_API_KEY and whose main.ts reads five more — so the first person
# to do the obvious thing would have had a live key staged by `git add -A`.
# Nothing here has ever held one; that is luck, not a control.
.env
.env.*
!.env.example

# Local credentials. apps/api/src/env-local.ts reads .env.local at the repo
# root; .dockerignore excludes .env* separately so an image can never bake one.
# Committing a provider key is not recoverable by deleting it in a later commit.
.env
.env.*
!.env.example

# Node / Playwright
node_modules/
test-results/
playwright-report/
live-harness.log
# Compiled output. Every workspace package now emits to dist/ and the container
# builds it in a Docker stage, so a committed dist/ could only ever be a stale
# copy that disagrees with src/ — and the export map points production AT it.
dist/
*.tsbuildinfo

# Application logs (dev). Production ships stdout to a log group — see architecture §14.
logs/

# Terraform. Provider binaries are hundreds of MB; lock files ARE committed
# (they pin provider versions), backend.tf and *.tfvars are not (they name real
# accounts). The production path has never been applied — see infra/README.md;
# envs/demo IS applied, with deliberately local (untracked) state.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
infra/envs/*/backend.tf
infra/envs/*/terraform.tfvars
infra/envs/*/plan-output.txt
