# Copy to .env.local (gitignored) for local development.
#
#   cp .env.example .env.local
#
# READ BEFORE USING:
#
#  * .env.local is read ONLY outside production, and it NEVER overrides a
#    variable already in the environment — `FOO=bar pnpm start` still wins.
#    See apps/api/src/env-local.ts.
#  * .dockerignore excludes .env* so an image can never bake one in.
#  * This file is committed. It must contain no real values, ever.

# ---------------------------------------------------------------- provider ---
# Without this the API uses the STUB router, which classifies every turn SAFE.
# A clean-looking local session on the stub is evidence that nothing was asked,
# not that the guards work. Create the key in its own Console workspace so it
# carries its own spend and rate limits.
ANTHROPIC_API_KEY=

# ------------------------------------------------- self-hosted lane + corpus ---
# An OpenAI-compatible endpoint we run ourselves (Ollama, mlx_lm, vLLM). It does
# two jobs and they are opted into together, because they are the same box:
#   1. the `local` PROVIDER, for cells that name it (see docs/chittu-model-plan.md)
#   2. the grounded-corpus EMBEDDER, which is what makes layer 6 do anything
# Unset means the corpus is OFF — and off is visible: no CORPUS layer is stamped
# in the walk at all, rather than one that ran nothing. main.ts prints which.
# CHITTU_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# CHITTU_LOCAL_API_KEY=
#
# The corpus is embedded with mxbai-embed-large (1024-d, which is why the column
# is vector(1024)). CHANGING THIS MEANS RE-EMBEDDING EVERYTHING: a different
# 1024-d model fails no check anywhere and simply retrieves confident nonsense
# from a vector space unrelated to the one the corpus lives in.
#   ollama pull mxbai-embed-large
# CHITTU_EMBED_MODEL=mxbai-embed-large

# ---------------------------------------------------------------- database ---
# REQUIRED — there is no in-process fallback. `pnpm start` defaults it to the
# dev container below and starts that container for you; set it here only to
# point somewhere else. `pnpm test` uses :55432/chittu_test independently.
# DATABASE_URL=postgres://chittu:chittu@localhost:55433/chittu

# ------------------------------------------------------------------ server ---
# PORT=8080
# HOST=127.0.0.1          # the Dockerfile sets 0.0.0.0; a laptop stays on loopback
# LOG_LEVEL=info
# LOG_DIR=logs            # empty means stdout only

# -------------------------------------------------------------------- keys ---
# Leave BOTH unset in dev and the local key provider is used. Setting the CMK
# opts in to KMS, which is what production runs — and then the index key is
# mandatory, because KMS cannot reproduce the same key bytes twice and a
# per-task blind index makes a parent unfindable by email from any other task.
#
#   openssl rand -base64 32
#
# CHITTU_KMS_KEY_ARN=arn:aws:kms:ap-south-1:<account>:key/<id>
# CHITTU_INDEX_KEY=

# Persists the LOCAL master key across restarts (dev only). Unset means an
# ephemeral key, so anything encrypted this run is unreadable after it exits.
# CHITTU_DEV_MASTER_KEY=

# ------------------------------------------------------------------- other ---
# CHITTU_OPS_TOKENS=name=token   # unset means /ops is not mounted at all (404)
# CHITTU_ROUTING_DB=off          # ignore provider_cell rows
# AWS_REGION=ap-south-1
