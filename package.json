{
  "name": "chittu",
  "private": true,
  "version": "0.1.0",
  "description": "Chittu \u2014 safety-first conversational AI for children. Phase 1 backend + the prototype regression harness.",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/**' exec tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prototype": "playwright test",
    "dev": "pnpm --filter @chittu/api run dev",
    "test:pg": "DATABASE_URL=postgres://chittu:chittu@localhost:55432/chittu_test vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "start": "bash scripts/dev.sh",
    "stack:up": "docker compose --profile dev up -d --build --wait",
    "stack:down": "docker compose --profile dev down",
    "stack:logs": "docker compose --profile dev logs -f api",
    "db:migrate": "pnpm --filter @chittu/api run migrate"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.9.0"
}
