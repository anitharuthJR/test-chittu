# Copy to terraform.tfvars (gitignored — it carries your IP and key, and in
# the created-EIP mode the tfvars is part of the record of what owns what).

# Your current egress IP, /32. curl -4 ifconfig.me
allowed_ssh_cidr = "203.0.113.7/32"

# The .pub line itself, not a path.
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# EITHER the hand-allocated EIP to adopt (association-only; destroy keeps it):
eip_allocation_id = "eipalloc-0123456789abcdef0"
# OR null / omitted: Terraform creates and owns the EIP — destroy releases it
# and the GoDaddy A record for chittu.tulifo.ai must be repointed.
